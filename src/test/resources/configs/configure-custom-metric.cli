embed-server --server-config=standalone-ha.xml --std-out=discard

# Set history and decay to 0 for immediate load reflection
/subsystem=modcluster/proxy=default/load-provider=dynamic:write-attribute(name=history,value=0)
/subsystem=modcluster/proxy=default/load-provider=dynamic:write-attribute(name=decay,value=0)

# Remove CPU metric
/subsystem=modcluster/proxy=default/load-provider=dynamic/load-metric=cpu:remove()

stop-embedded-server
